{
  "name": "aliflix-recommendations",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "GEMINI_GENERATION_MODEL": "gemini-3.6-flash",
    "GEMINI_EMBEDDING_MODEL": "gemini-embedding-2"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RECOMMENDATION_SESSIONS",
        "class_name": "RecommendationSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RecommendationSession"]
    }
  ],
  "ratelimits": [
    {
      "name": "RECOMMENDATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
