#EXTM3U
#EXT-X-VERSION:7
#EXT-X-INDEPENDENT-SEGMENTS

#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="audio",NAME="Track 1",DEFAULT=YES,AUTOSELECT=YES,URI="https://cdn.example/hls/dark/audio_1.m3u8"
#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="audio",NAME="Track 2",DEFAULT=NO,AUTOSELECT=YES,URI="https://cdn.example/hls/dark/audio_2.m3u8"
#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="audio",NAME="Track 3",DEFAULT=NO,AUTOSELECT=YES,URI="https://cdn.example/hls/dark/audio_3.m3u8"
#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID="audio",NAME="Track 4",DEFAULT=NO,AUTOSELECT=YES,URI="https://cdn.example/hls/dark/audio_4.m3u8"

# 4K HEVC
#EXT-X-STREAM-INF:BANDWIDTH=16000000,AVERAGE-BANDWIDTH=16000000,RESOLUTION=3840x2160,CODECS="hvc1.1.2.L150.B0,mp4a.40.2",AUDIO="audio"
https://cdn.example/video/dark/video_4k.h265.m3u8
# 1080p
#EXT-X-STREAM-INF:DEFAULT=YES,BANDWIDTH=6000000,AVERAGE-BANDWIDTH=6000000,RESOLUTION=1920x1080,CODECS="avc1.4D4032,mp4a.40.2",AUDIO="audio"
https://cdn.example/video/dark/video_1080p.m3u8
# 720p
#EXT-X-STREAM-INF:BANDWIDTH=3000000,AVERAGE-BANDWIDTH=3000000,RESOLUTION=1280x720,CODECS="avc1.4D4020,mp4a.40.2",AUDIO="audio"
https://cdn.example/video/dark/video_720p.m3u8
# 360p
#EXT-X-STREAM-INF:BANDWIDTH=900000,AVERAGE-BANDWIDTH=900000,RESOLUTION=640x360,CODECS="avc1.4D401E,mp4a.40.2",AUDIO="audio"
https://cdn.example/video/dark/video_360p.m3u8