root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,java,xml,py,ps1}]
indent_style = space
indent_size = 4

[*.{ts,mjs,json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[app/src/test/resources/rt/*.html]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
